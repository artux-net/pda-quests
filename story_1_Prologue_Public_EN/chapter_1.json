      "title": "Arkady the Jew",
      "message": "",
      "type_message": 0,
      "texts": [
        {
          "text": "Let's just say: from the West. I'm a military medic.",
          "condition": {}
        }
      ],
      "transfers": [
        {
          "text": "And what, you couldn't sit still over there, comrade sawbones?",
