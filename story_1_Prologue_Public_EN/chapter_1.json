      "background": "story/prologue/screen/chapter_0_1.jpg",
      "title": "Chapter One. Vlad the Communist",
      "message": "",
      "type_message": 0,
      "texts": [
        {
          "text": "The Communist earned his nickname for the vibe he brings wherever he goes: he always knows how to create a cozy, warm atmosphere and bring people together, constantly cracking jokes about the Soviet Union and the idea of communism. Perceptive and reasonably demanding, kind and attentive, true to his word and fair. He helps anyone in a tough spot and tries to make friends with everyone. He can't stand it when people give up, won't let anyone wallow — otherwise he gets angry and feels guilty about it.",
          "condition": {}
        }
      ],
      "transfers": [
        {
          "text": "Start",
          "stage": 6,
          "condition": {}
        }
